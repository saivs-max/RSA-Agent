# ─── Slack (Socket Mode) ──────────────────────────────────────────────────────
# Bot Token: OAuth & Permissions → Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level Token: Basic Information → App-Level Tokens (starts with xapp-)
# Required for Socket Mode. Scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-level-token

# Signing Secret: Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# Bot's own Slack user ID (used to strip @mentions from text)
# Find it: Settings → Basic Information → App Credentials → App ID
# Or: run the bot once and check logs — Slack prints it on connect
SLACK_BOT_USER_ID=U0XXXXXXXXX

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Model to use for the agent loop (sonnet = good balance; opus = more capable)
AGENT_MODEL=claude-sonnet-4-6

# ─── Google Apps Script Web App ───────────────────────────────────────────────
# After deploying Code.gs as a Web App, paste the URL here.
GAS_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Shared secret — must match AGENT_SECRET in GAS_BotEndpoints.gs
AGENT_SECRET=rsa-agent-secret-change-me

# ─── Nicole's Slack User ID (TRUNO contact, used in GAS for @mention) ─────────
# Set in GAS_BotEndpoints.gs — not needed here unless you add Slack DM to Nicole

# ─── Winter Scales (NJ-only alternative vendor) ───────────────────────────────
# For NJ stores the agent asks TRUNO vs Winter Scales instead of defaulting to
# TRUNO. Picking Winter Scales adds the cart as "Pending RSA" and emails these
# contacts (via the GAS web app, which sends mail) to request scheduling; ops then
# follows up directly. Comma-separated. Keep in sync with WINTERSCALES_EMAILS in
# GAS_BotEndpoints.gs. Defaults to the three contacts below if unset.
WINTERSCALES_EMAILS=service@winterscale.com, john.winter@winterscale.com, rich.ianniello@winterscale.com

# ─── Drive folder monitors ────────────────────────────────────────────────────
# Share BOTH folders with the service-account email (Viewer) and enable the Drive API.
# W&M Scale Test Forms (pass/fail → RSA Test Results, col U). Defaults to the live folder.
RSA_FORMS_FOLDER_ID=1nXWekoXow3-az02QHfVSx7PJQP4uA4vx
# Tech calibration sheets (load/shift readings → Tech Results, col V). Defaults to the live folder.
TECH_RESULTS_FOLDER_ID=1g7myq_dnWCJqOqYgVzAapks4aJ7UBrHX
# Optional: Slack channel ID where monitors post results + the daily gap report.
RSA_MONITOR_CHANNEL=C0ARJQWG7RP
# Optional tuning (seconds). Tech poll interval and the results-completeness gap report cadence.
RSA_TECH_POLL_SECONDS=300
RSA_GAP_REPORT_SECONDS=86400
# Optional: override the Tech Results column placement (defaults V=22, W=23; auto-resolved by header).
RSA_TECH_RESULTS_COL=22
RSA_TECH_RESULTS_LINK_COL=23
